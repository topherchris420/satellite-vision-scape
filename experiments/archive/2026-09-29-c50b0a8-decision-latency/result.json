 "title": "Does decision latency change what happens in the world?",
 "status": "complete",
 "definition": {
  "schema": "svs-experiment/v1",
  "id": "decision-latency",
  "title": "Does decision latency change what happens in the world?",
  "question": "Jev answered in 289 ms (median) in run B. Would a slower model do worse at After Hours, or merely take longer?",
  "hypothesis": "At run B's latency the world is insensitive to decision speed. At four times run B's latency the whole journey takes measurably longer (at least 10 s), but completion and the coffee are unchanged, because the executor, not the decision loop, does the time-critical control.",
  "motivation": {
   "observation": "NEXT_MODEL.md argues speed is not today's constraint (p95 397 ms against a 6 s timeout). That was an argument from one run, not a measurement: nothing has ever varied latency and watched the world.",
   "evidence": [
    "docs/NEXT_MODEL.md §3: latency median / p95 289 / 397 ms"
   ]
  },
  "environment": "pine-gap",
  "task": "after-hours",
  "episode": {
   "until": "task_complete",
   "maxSimSeconds": 900,
   "maxCallsPerRun": 400
  },
  "independentVariable": "latency",
  "controlled": {
   "provider": "baseline"
  },
  "conditions": [
   {
    "id": "instant",
    "label": "Instant (a scripted policy's own speed)",
    "set": {
     "latency": "instant"
    }
   },
   {
    "id": "run-b",
    "label": "Run B's recorded latencies",
    "set": {
     "latency": "run-b"
    }
   },
   {
    "id": "run-b-x4",
    "label": "Four times slower",
    "set": {
     "latency": "run-b-x4"
    }
   },
   {
    "id": "run-b-x10",
    "label": "Ten times slower",
    "set": {
     "latency": "run-b-x10"
    }
   }
  ],
  "runsPerCondition": 10,
  "seed": 1,
  "dependentMetrics": [
   "completed",
